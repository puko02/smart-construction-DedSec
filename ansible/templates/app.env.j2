WEB_IMAGE={{ app_registry }}/web:{{ app_image_tag }}
API_IMAGE={{ app_registry }}/api:{{ app_image_tag }}
APP_PRIVATE_IP={{ app_private_ip }}
DB_PRIVATE_IP={{ db_private_ip }}
HTTP_PORT=8080
PUBLIC_ORIGIN={{ app_public_origin }}
REGISTRATIONS_UI_ENABLED={{ registrations_enabled | default(true) | ternary('true', 'false') }}
SMART_API_REGISTRATIONS_ENABLED={{ registrations_enabled | default(true) | ternary('true', 'false') }}
SMART_API_TERMS_VERSION={{ terms_version | default('termos-lab-2026-11-11') }}
SMART_API_PRIVACY_VERSION={{ privacy_version | default('privacidade-lab-2026-11-11') }}
ASSETS_BUCKET=smart-assets
SMART_SECRETS_DIR=.secrets
